<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="Gemini.Enabled" value="true" />
		<add key="Gemini.Model" value="gemini-2.5-flash" />
		<add key="Gemini.ApiKeyEnvironmentVariable" value="GEMINI_API_KEY" />
		<add key="Gemini.EndpointFormat" value="https://generativelanguage.googleapis.com/v1beta/models/{0}:generateContent" />
		<add key="Gemini.MaxOutputTokens" value="1200" />
		<add key="Gemini.ThinkingBudget" value="0" />
		<add key="Gemini.Temperature" value="0.2" />
	</appSettings>

	<connectionStrings>
		<add name="SmartPOSConnection"
			 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=SmartPOSWinForms;Integrated Security=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
</configuration>
